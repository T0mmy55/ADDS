# DESCRIPTION 
# - Backup all primary DNS zones to a newly created random folder under C:\Temp\DNS\DNS_Xxxxxxx 

# REQUIREMENTS 
#  - Run on a Domain Controller OR domain-joined machine with RSAT installed
#  - Requires Domain Admin or DNS Admin privileges
#  - PowerShell v2 or above

# EXAMPLE 
# .\Backup_DNS_v1.ps1

#>

# Variable: generate a random number for unique folder naming
$rand = Get-Random
$i = 1
# Create random base DNS backup directory 

$DNSbackupdir = "C:\Temp\DNS\DNS_$rand"
if (!(Test-Path -Path $DNSbackupdir)) {
    New-Item -ItemType Directory -Path $DNSbackupdir -Force
}

# Get all relevant primary DNS zones excluding reverse lookup, forwarders, and Trust Anchors
write-host "[+] Getting DNS Zones, please wait..." -ForegroundColor Green
try {
$zones = Get-DnsServerZone | Where-Object { $_.ZoneName -notlike "*in-addr*" -and $_.ZoneType -ne "Forwarder" -and $_.ZoneName -notlike "*TrustAnchors*"}

# Display all relevant primary DNS zones excluding reverse lookup, forwarders, and Trust Anchors
write-host "[+] Primary DNS zones : " $zones.count -ForegroundColor DarkBlue
 
$zones | ForEach-Object {
Write-Host "Primary DNS zone found [$i] : " $_.ZoneName -ForegroundColor DarkBlue
$i++
}

# Processing Old and new saved DNS Zones
foreach ($zone in $zones) {
    $zoneName = $zone.ZoneName
    if ((Test-Path -Path "C:\Windows\System32\dns\$zoneName.dns")) {
    try {
    Remove-Item "C:\Windows\System32\dns\$zoneName.dns" -Force
    
    }
    catch {
    write-host "==> Old file C:\Windows\System32\dns\$zoneName.dns was not removed !" -ForegroundColor Red
    }

    sleep 2
}
# Exporting DNS Zones to "C:\Windows\System32\dns"

Write-Host "[+] Exporting DNS Zones $zoneName to C:\Windows\System32\dns" -ForegroundColor Yellow

    try {
        
        # Export zone file using PowerShell cmdlet
        Export-DnsServerZone -Name $zoneName -FileName "$zoneName.dns" -ErrorAction Stop
        write-host "==> $zoneName.dns exported to C:\Windows\System32\dns\$zoneName.dns" -ForegroundColor Yellow
    } 
    
    catch {
        write-host "==> Failed to export zone C:\Windows\System32\dns\$zoneName.dns" -ForegroundColor Red
        
    }
}

Write-Host "[+] Export completed. All files have been saved by default in C:\Windows\System32\dns" -ForegroundColor Green


# Wait 5 seconds - optional, but could be reduced or removed unless needed for file operations
Start-Sleep -Seconds 5

# Move the exported zone files from system DNS folder to backup folder
foreach ($zone in $zones) {
    $zoneFile = "$($zone.ZoneName).dns"
    $sourcePath = "C:\Windows\System32\dns\$zoneFile"
    $destinationPath = Join-Path -Path $DNSbackupdir -ChildPath $zoneFile
    Write-Host "[+] Copying DNS Zones $zoneFile to C:\Temp\DNS\DNS_$rand" -ForegroundColor Blue
    if (Test-Path $sourcePath) {
        Copy-Item -Path $sourcePath -Destination $destinationPath -Force
        write-host "==> $sourcePath copied to $destinationPath" -ForegroundColor Yellow
    } else {
        Write-host "==> File not found: $sourcePath" -ForegroundColor Red
    }
}

Write-Host "[+] DNS Backup files moved to $DNSbackupdir" -ForegroundColor Green

}
catch
{
write-host "[+] unable to get DNS zones ! Check your DNS server !" -ForegroundColor Red
}






